GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# auto: Gemini first; openrouter: prefer the configured OpenRouter model
KODA_AI_PROVIDER=auto
KODA_API_PORT=3333
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Optional server-side equivalents; the server falls back to the EXPO_PUBLIC values above.
SUPABASE_URL=
SUPABASE_ANON_KEY=
EXPO_PUBLIC_KODA_API_URL=http://127.0.0.1:3333

# Yandex AI Studio: server-only credentials for the upcoming comparison
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_MODEL=yandexgpt-5.1
